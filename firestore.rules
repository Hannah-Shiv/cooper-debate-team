rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: is the caller a known coach? ─────────────────────────────────
    // The email comes from the verified Firebase Auth token, not from the client.
    // Update this list whenever coach accounts change (same workflow as admins.js).
    function isCoach() {
      return request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() in [
          'pgkonde@fcps.edu',        // Coach Konde
          'hannahbshiv@gmail.com'    // temp coach for testing
        ];
    }

    // Announcements — any signed-in member can read
    // Write access (coach/captain only) is enforced in app logic
    match /announcements/{docId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }

    // FCM push-notification tokens — each user may only write their own token
    match /fcm-tokens/{email} {
      allow read, write: if request.auth != null
        && request.auth.token.email.lower() == email;
    }

    // Resource card pins — any signed-in member can read
    // Write access (coach/captain only) is enforced in app logic
    match /resource-pins/{cardId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }

    // Tournament calendar events — any signed-in member can read
    // Write access (coach/captain only) is enforced in app logic
    match /tournaments/{docId} {
      allow read:  if request.auth != null;
      // Existing private-event editing remains available to signed-in members.
      // Only a verified coach may create, change, or delete an event once it
      // is public, preventing a member edit from changing public content.
      allow create: if request.auth != null &&
        (isCoach() || request.resource.data.isPublic != true);
      allow update: if request.auth != null &&
        (isCoach() || (resource.data.isPublic != true &&
          request.resource.data.isPublic != true));
      allow delete: if request.auth != null &&
        (isCoach() || resource.data.isPublic != true);
    }

    // Public calendar records are a narrow, server-generated projection of
    // member calendar events. Browsers may read them, but only Cloud Functions
    // may create, update, or delete them.
    match /public_calendar_events/{docId} {
      allow read:  if true;
      allow write: if false;
    }

    // Tournament stat results — public read (shown on tournaments.html), coach write
    match /stat_results/{docId} {
      allow read:   if true;
      allow write:  if isCoach();
    }

    // Roster — coach read/write only (contains email, phone, notes)
    match /members/{docId} {
      allow read, write: if isCoach();
    }

    // Notification error log — written only by Cloud Functions (admin SDK bypasses rules).
    // Readable only by coaches; no client writes permitted.
    match /notification-errors/{docId} {
      allow read:  if isCoach();
      allow write: if false;  // Cloud Functions use admin SDK — rules don't apply
    }

    // Volunteer opportunities are published to parents through a Cloud
    // Function, which returns only safe event details and remaining openings.
    // Coaches manage events directly; private signup records are never
    // readable from the public site.
    match /volunteer_events/{docId} {
      allow read:  if isCoach();
      allow write: if false;  // Coach mutations go through a checked transaction
    }

    match /volunteer_signups/{docId} {
      allow read:  if isCoach();
      allow write: if false;  // Cloud Function validates public submissions
    }

    match /volunteer_signup_keys/{docId} {
      allow read, write: if false;  // Cloud Function only
    }

    // Delivery records contain only status, timestamps, and internal IDs.
    // They are never publicly readable and are visible to coaches only.
    match /volunteer_email_notifications/{docId} {
      allow read:  if isCoach();
      allow write: if false;  // Cloud Functions use the Admin SDK
    }

    // Team applications contain student and family contact information.
    // They are created and updated only through the validated Cloud Function.
    match /applications/{docId} {
      allow read:  if isCoach();
      allow write: if false;
    }

    // Email acceptance records support coach-only delivery audits. They do not
    // contain application answers and are written only by the Cloud Function.
    match /application_email_notifications/{docId} {
      allow read:  if isCoach();
      allow write: if false;
    }

    // A hashed, server-only rate-limit marker prevents the public application
    // endpoint from being used for unchecked mass-email requests.
    match /application_submission_limits/{docId} {
      allow read, write: if false;
    }

  }
}
