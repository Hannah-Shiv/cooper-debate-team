rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Member and role authorization ─────────────────────────────────────────
    // These checks run on Firebase's servers. Client-side lists only control the
    // interface and must never be treated as the security boundary.
    function hasVerifiedEmail() {
      return request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email_verified == true;
    }

    function userEmail() {
      return request.auth.token.email.lower();
    }

    function isGoogleSignIn() {
      return request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // Google sign-in is reserved for approved FCPS Workspace identities.
    // Approved non-FCPS adults continue to use Firebase email-link authentication.
    function usesAllowedSignInMethod() {
      return !isGoogleSignIn() ||
        userEmail().matches('^[^@]+@(fcps[.]edu|fcpsschools[.]net)$');
    }

    function hasPortalMemberRecord() {
      return hasVerifiedEmail() &&
        exists(/databases/$(database)/documents/portal_members/$(userEmail()));
    }

    function portalMember() {
      return get(/databases/$(database)/documents/portal_members/$(userEmail())).data;
    }

    // Directory-managed records are authoritative per email identity. The small
    // fallback list keeps existing accounts working until a coach or website admin
    // opens the roster and synchronizes those people into portal_members.
    function isApprovedMember() {
      return hasVerifiedEmail() &&
        usesAllowedSignInMethod() &&
        (
          (hasPortalMemberRecord() && portalMember().active == true) ||
          (!hasPortalMemberRecord() && userEmail() in [
            'pgkonde@fcps.edu',
            'pgkonde@fcpsschools.net',
            'hannahbshiv@gmail.com',
            'cooperdebateteam@gmail.com',
            '1806950@fcpsschools.net'
          ])
        );
    }

    // Coach and Website Admin deliberately share the same full permission set.
    function isCoach() {
      return isApprovedMember() &&
        (
          userEmail() == '1806950@fcpsschools.net' ||
          (hasPortalMemberRecord() &&
            portalMember().role in ['coach', 'website-admin']) ||
          (!hasPortalMemberRecord() && userEmail() in [
            'pgkonde@fcps.edu',
            'pgkonde@fcpsschools.net',
            'hannahbshiv@gmail.com',
            '1806950@fcpsschools.net'
          ])
        );
    }

    function isCaptain() {
      return isApprovedMember() &&
        hasPortalMemberRecord() &&
        portalMember().role == 'captain';
    }

    function canManageMemberContent() {
      return isCoach() || isCaptain();
    }

    // Announcements — approved members read; coaches/captains manage.
    match /announcements/{docId} {
      allow read: if isApprovedMember();
      allow create: if canManageMemberContent() &&
        request.resource.data.postedBy == userEmail() &&
        ((isCoach() && request.resource.data.postedByRole in ['coach', 'website-admin']) ||
          (isCaptain() && request.resource.data.postedByRole == 'captain'));
      allow update: if canManageMemberContent() &&
        request.resource.data.postedBy == resource.data.postedBy &&
        request.resource.data.postedByRole == resource.data.postedByRole &&
        (isCoach() || resource.data.postedBy == userEmail());
      allow delete: if isCoach() ||
        (isCaptain() && resource.data.postedBy == userEmail());
    }

    // FCM push-notification tokens — each user may only write their own token
    match /fcm-tokens/{email} {
      allow read, write: if isApprovedMember() && userEmail() == email;
    }

    // Pre-authentication email-link checks use only a SHA-256 document ID and
    // expose one boolean. Exact document reads are public; enumeration is not.
    match /portal_login_status/{emailHash} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isCoach();
      allow delete: if false;
    }

    // Each signed-in person can read only their own access record, including an
    // inactive record needed to show a clear denial. Full admins manage all
    // records through the Members Directory.
    match /portal_members/{email} {
      allow get: if hasVerifiedEmail() && (userEmail() == email || isCoach());
      allow list: if isCoach();
      allow create, update: if isCoach();
      allow delete: if false;
    }

    // Resource card pins — approved members read; coaches/captains manage.
    match /resource-pins/{cardId} {
      allow read:  if isApprovedMember();
      allow write: if canManageMemberContent();
    }

    // Tournament calendar events — approved members can read. Existing private
    // event editing remains available to approved members; public events remain
    // coach-controlled.
    match /tournaments/{docId} {
      allow read:  if isApprovedMember();
      // Existing private-event editing remains available to approved members.
      // Only a verified coach may create, change, or delete an event once it
      // is public, preventing a member edit from changing public content.
      allow create: if isApprovedMember() &&
        (isCoach() || request.resource.data.isPublic != true);
      allow update: if isApprovedMember() &&
        (isCoach() || (resource.data.isPublic != true &&
          request.resource.data.isPublic != true));
      allow delete: if isApprovedMember() &&
        (isCoach() || resource.data.isPublic != true);
    }

    // Public calendar records are a narrow, server-generated projection of
    // member calendar events. Browsers may read them, but only Cloud Functions
    // may create, update, or delete them.
    match /public_calendar_events/{docId} {
      allow read:  if true;
      allow write: if false;
    }

    // Tournament stat results — public read (shown on tournaments.html), coach write
    match /stat_results/{docId} {
      allow read:   if true;
      allow write:  if isCoach();
    }

    // Roster — coach read/write only (contains email, phone, notes)
    match /members/{docId} {
      allow read, write: if isCoach();
    }

    // Notification error log — written only by Cloud Functions (admin SDK bypasses rules).
    // Readable only by coaches; no client writes permitted.
    match /notification-errors/{docId} {
      allow read:  if isCoach();
      allow write: if false;  // Cloud Functions use admin SDK — rules don't apply
    }

    // Volunteer opportunities are published to parents through a Cloud
    // Function, which returns only safe event details and remaining openings.
    // Coaches manage events directly; private signup records are never
    // readable from the public site.
    match /volunteer_events/{docId} {
      allow read:  if isCoach();
      allow write: if false;  // Coach mutations go through a checked transaction
    }

    match /volunteer_signups/{docId} {
      allow read:  if isCoach();
      allow write: if false;  // Cloud Function validates public submissions
    }

    match /volunteer_signup_keys/{docId} {
      allow read, write: if false;  // Cloud Function only
    }

    // Delivery records contain only status, timestamps, and internal IDs.
    // They are never publicly readable and are visible to coaches only.
    match /volunteer_email_notifications/{docId} {
      allow read:  if isCoach();
      allow write: if false;  // Cloud Functions use the Admin SDK
    }

    // Team applications contain student and family contact information.
    // They are created and updated only through the validated Cloud Function.
    match /applications/{docId} {
      allow read:  if isCoach();
      allow write: if false;
    }

    // Email acceptance records support coach-only delivery audits. They do not
    // contain application answers and are written only by the Cloud Function.
    match /application_email_notifications/{docId} {
      allow read:  if isCoach();
      allow write: if false;
    }

    // A hashed, server-only rate-limit marker prevents the public application
    // endpoint from being used for unchecked mass-email requests.
    match /application_submission_limits/{docId} {
      allow read, write: if false;
    }

  }
}
